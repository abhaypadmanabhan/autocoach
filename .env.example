# Supabase Configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Qdrant Configuration
QDRANT_URL=
QDRANT_API_KEY=
# Background ping interval to keep Qdrant Cloud cluster from suspension. 0 disables.
QDRANT_KEEPALIVE_INTERVAL_S=300

# LLM APIs Configuration
KIMI_API_KEY=
OPENAI_API_KEY=

# URL Configuration
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# CORS - comma-separated list of allowed origins
FRONTEND_ORIGINS=https://autocoach-rho.vercel.app,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false

# Environment Configuration ("development" or "production")
ENVIRONMENT=development

# Abuse Controls
ADMIN_EMAILS=
MAX_DOCUMENT_MB=20
MAX_DOCUMENTS_PER_USER=2
MAX_QUIZ_SESSIONS_PER_DAY=5
QUIZ_REQUESTS_PER_MINUTE=60

# Adaptive Loop / Async Generation
# Time-to-live in seconds before next /next request marks generating question 'failed' and retries
GENERATION_STALE_TTL_SECONDS=30
# Long-poll cap in milliseconds on GET /next
NEXT_QUESTION_MAX_WAIT_MS=10000

# Langfuse / Observability Configuration
# Observability module runs in NOOP path if any of these three keys is missing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_ENVIRONMENT=development

# Sentry Configuration
SENTRY_DSN=

# Frontend Analytics (Frontend-only keys)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
